# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_password_here
DB_NAME=tns_new

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Cashfree API Credentials
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_API_BASE_URL=https://api.cashfree.com/verification

# App Configuration
NODE_ENV=development
PORT=6000

# Remote Image Upload (optional)
# Base URL of the remote product API used to upload images
REMOTE_PRODUCT_BASE_URL=https://thenirmanstore.com
# When creating ProductRequest (which has no product id), optionally target a fixed remote product id
# or pass `remote_product_id` in request body; if not provided, local upload fallback is used
REMOTE_UPLOAD_TARGET_PRODUCT_ID=
